{
  "name": "companion-space",
  "private": true,
  "packageManager": "npm@11.21.2",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "overrides": {
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api-client.mjs",
    "generate:api:check": "node scripts/generate-api-client.mjs --check",
    "test:e2e": "playwright test",
    "test:startup": "node tests/e2e/startup-check.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
