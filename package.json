{
  "name": "companion-space",
  "private": true,
  "packageManager": "npm@11.21.2",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "test:bootstrap": "node --test tests/e2e/runtime.test.mjs",
    "dev:web": "npm run dev --workspace web -- --port 3000 --hostname 127.0.0.1",
    "build:web": "npm run build --workspace web",
    "build:mobile": "npm run build --workspace @companion-space/mobile",
    "ios:device": "npm run ios:device --workspace @companion-space/mobile",
    "check:mobile": "npm run check --workspace @companion-space/mobile",
    "lint:web": "npm run lint --workspace web",
    "typecheck:web": "npm run typecheck --workspace web",
    "typecheck:mobile": "npm run typecheck --workspace @companion-space/mobile",
    "repair:original-vrm-face": "node scripts/repair-original-vrm-face.mjs",
    "test:original-vrm-face": "node scripts/repair-original-vrm-face.mjs --check && node --test scripts/repair-original-vrm-face.test.mjs",
    "test:original-vrm": "node scripts/generate-original-vrm.mjs --check && npm run test:original-vrm-face && node scripts/verify-original-vrm-runtime.mjs",
    "test:vrm-viseme": "node --experimental-strip-types --test scripts/vrm-viseme.test.mjs",
    "test:vrm-appearance": "node --experimental-strip-types --test scripts/vrm-appearance.test.mjs",
    "test:runtime-config": "node --experimental-strip-types scripts/check-runtime-config.mjs",
    "test:pet-assets": "node --test --test-isolation=none scripts/check-pet-assets.test.mjs && node scripts/check-pet-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:vrm-performance": "node scripts/run-realtime-check.mjs performance",
    "test:e2e:realtime-soak": "node scripts/run-realtime-check.mjs soak",
    "test:e2e:realtime-soak:smoke": "node scripts/run-realtime-check.mjs soak-smoke",
    "test:windows-startup": "node --test scripts/start-local-windows.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
