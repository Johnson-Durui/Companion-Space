# Entries in the example are optional. Provider keys belong in app settings.
# Paths are resolved relative to the Companion Space application directory.
COMPANION_DATA_DIR=./storage
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
# Local development may set additional comma-separated browser origins.
ALLOWED_ORIGINS=
SQLITE_BUSY_TIMEOUT_MS=5000
BUILTIN_NEURAL_TTS_ENABLED=false
LOCAL_NEURAL_TTS_BASE_URL=http://127.0.0.1:8001
