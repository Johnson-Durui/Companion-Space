APP_ENV=development
APP_DISPLAY_NAME=Companion Space
APP_HOST=companion.localhost
# Set this only when APP_HOST also exposes a direct IP HTTPS origin. It lets
# Caddy serve the matching certificate to clients that omit SNI for IP hosts.
MOBILE_DEFAULT_SNI=companion.localhost
APP_BASE_URL=https://companion.localhost
API_BASE_URL=http://api:8000
# Comma-separated browser origins. The packaged Android/iOS launcher origins
# are always included explicitly; wildcard origins are not used.
ALLOWED_ORIGINS=https://companion.localhost
# Build-time allowlist for apps/mobile. Set this to a real phone-reachable HTTPS
# origin before running build:mobile; companion.localhost is not a phone target.
COMPANION_MOBILE_TRUSTED_ORIGINS=

OBJECT_STORAGE_PATH=./storage
SQLITE_BUSY_TIMEOUT_MS=5000
EMBEDDING_PROVIDER=bge_m3
RERANKER_PROVIDER=bge_reranker_v2_m3
RETRIEVAL_TOP_K=4
MAX_DOCUMENT_SIZE_BYTES=52428800
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=2000000
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
ALLOW_ML_FALLBACK=true

MEMORY_WRITE_ENABLED=true
AUDIO_PERSIST_ENABLED=false
CITATION_REQUIRED=true
BUILTIN_NEURAL_TTS_ENABLED=false
LOCAL_NEURAL_TTS_BASE_URL=http://neural-tts:8001
# Enable this GPU-only service with COMPOSE_PROFILES=neural-tts.
COMPOSE_PROFILES=
TTS_DEVICE=cuda
# Optional bind mount for the ~2.5 GB cache, for example ./qwen3-tts-cache
TTS_MODEL_CACHE_PATH=qwen3_tts_model_cache

# Runtime container caps total 11.9375 GiB by default. Pair these with the
# repository's 14 GB WSL cap so Docker/WSL stays about 12.5% below a 16 GB host.
# Keep the TTS value unchanged unless monitoring proves a smaller cap is safe.
CADDY_MEMORY_LIMIT=192m
CADDY_MEMORY_RESERVATION=64m
WEB_MEMORY_LIMIT=768m
WEB_MEMORY_RESERVATION=256m
API_MEMORY_LIMIT=5g
API_MEMORY_RESERVATION=2g
TTS_MEMORY_LIMIT=6g
TTS_MEMORY_RESERVATION=3g
# Build one image at a time so peak build work stays inside the WSL-wide cap.
COMPOSE_PARALLEL_LIMIT=1
# Smaller glibc arena counts reduce fragmentation without changing model quality.
API_MALLOC_ARENA_MAX=2
TTS_MALLOC_ARENA_MAX=2

NEXT_PUBLIC_API_BASE_URL=/
NEXT_PUBLIC_REALTIME_WS_URL=/api/v1/sessions/:sessionId/realtime
# Optional, same-origin modules supplied by a license holder. Leave empty to
# import Live2D/Spine AIRI assets safely while keeping their rendering blocked.
NEXT_PUBLIC_LIVE2D_RUNTIME_BRIDGE_URL=
NEXT_PUBLIC_SPINE_RUNTIME_BRIDGE_URL=
