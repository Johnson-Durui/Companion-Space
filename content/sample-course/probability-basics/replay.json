  "lesson_plan": {
    "title": "事件及事件发生",
    "est_minutes": 25,
    "objectives": [
      {
        "kp_id": "e7eb9340cd8b5f5892ad52494fa1a4c0",
        "text": "能将文字描述的事件表示为样本点集合，并根据实际结果是否属于该集合判断事件是否发生。"
      }
    ],
    "segments": [
      {
        "id": "s1",
        "kp_id": "e7eb9340cd8b5f5892ad52494fa1a4c0",
        "kind": "concept",
        "goal": "理解事件是由样本点组成的集合，并用集合成员关系判断事件是否发生。",
        "est_minutes": 25,
        "keypoints": [
          "由若干样本点组成的集合叫事件；描述事件时，要找出符合描述的所有样本点。",
          "事件发生当且仅当试验的实际结果属于该事件对应的集合。"
        ],
        "approaches": [
          {
            "kind": "intuition",
            "keypoint": "all",
            "outline": "把事件想成一张收纳符合条件结果的清单：先根据事件描述列出清单，再检查实际结果是否在清单中。"
          },
          {
            "kind": "visual",
            "keypoint": "all",
            "outline": "画出样本空间 Ω 的大框，在其中圈出构成事件的样本点；将实际结果标记出来，落在圈内表示事件发生，落在圈外表示不发生。"
          },
          {
            "kind": "example",
            "keypoint": "all",
            "outline": "以同时掷两枚可区分的硬币为例，列出 Ω={HH,HT,TH,TT}，再分别圈出“恰有一个正面”和“至少一个正面”的结果，并代入具体结果判断。"
          },
          {
            "kind": "formal",
            "keypoint": "all",
            "outline": "设样本空间为 Ω，事件为其子集 A；事件发生的判定条件是实际结果 ω∈A，若 ω∉A，则事件不发生。"
          }
        ],
        "examples": [
          {
            "type": "set",
            "stem": "同时掷两枚可区分的硬币。用样本点集合表示事件“恰有一个正面”。",
            "answer": "A={HT,TH}",
            "solution": "两枚硬币的结果分别按顺序记录。恰有一个正面的结果是第一枚正面、第二枚反面（HT），或第一枚反面、第二枚正面（TH），所以事件为 {HT,TH}。",
            "verify": {
              "status": "verified",
              "solved_answer": "{(正面,反面), (反面,正面)}",
              "reason": "Independent solution agrees with the reference answer."
            },
            "origin": {
              "kind": "generated"
            }
          },
          {
            "type": "set_membership",
            "stem": "同时掷两枚可区分的硬币。事件 B 是“至少一个正面”，即 B={HH,HT,TH}。若实际结果为 TT，事件 B 是否发生？",
            "answer": "不发生",
            "solution": "判断实际结果是否属于事件集合。TT 不在 B={HH,HT,TH} 中，因此事件 B 不发生。",
            "verify": {
